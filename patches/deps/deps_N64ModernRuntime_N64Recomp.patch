 }
 
 static inline void DDIVU(uint64_t a, uint64_t b, uint64_t* quot, uint64_t* rem) {
+    if (b == 0) {
+        // See DIV below: the VR4300 does not trap on a zero divisor.
+        *quot = 0xFFFFFFFFFFFFFFFFull;
+        *rem = a;
+        return;
+    }
     *quot = a / b;
     *rem = a % b;
 }
 
+/*
+ * VR4300 32-bit integer division.
+ *
+ * The R4x00/VR4300 does not raise an exception for a zero divisor or for the
+ * INT_MIN / -1 overflow case. It leaves architecturally unpredictable values in
+ * HI/LO and execution continues, so guest code is free to divide by zero and
+ * (as Toy Story 2 does) test the result afterwards.
+ *
+ * Emitting a bare C '/' instead traps on x86 (#DE, raised to the process as
+ * STATUS_INTEGER_DIVIDE_BY_ZERO / 0xC0000094), turning code the real console
+ * runs fine into a hard crash. These helpers reproduce the documented VR4300
+ * result for both edge cases so recompiled code behaves like the hardware.
+ *
+ * Out-params are the generated functions' uint64_t hi/lo temporaries. The
+ * 32-bit quotient and remainder are sign-extended into them, matching the
+ * S32(...) result shape the previous inline emission produced.
+ */
+static inline void DIV(int32_t a, int32_t b, uint64_t* quot, uint64_t* rem) {
+    int32_t q;
+    int32_t r;
+
+    if (b == 0) {
+        q = (a < 0) ? 1 : -1;
+        r = a;
+    }
+    else if ((uint32_t)a == 0x80000000u && b == -1) {
+        q = a;
+        r = 0;
+    }
+    else {
+        q = a / b;
+        r = a % b;
+    }
+
+    *quot = (uint64_t)(int64_t)q;
+    *rem = (uint64_t)(int64_t)r;
+}
+
+static inline void DIVU(uint32_t a, uint32_t b, uint64_t* quot, uint64_t* rem) {
+    uint32_t q;
+    uint32_t r;
+
+    if (b == 0u) {
+        q = 0xFFFFFFFFu;
+        r = a;
+    }
+    else {
+        q = a / b;
+        r = a % b;
+    }
+
+    *quot = (uint64_t)(int64_t)(int32_t)q;
+    *rem = (uint64_t)(int64_t)(int32_t)r;
+}
+
 typedef uint64_t gpr;
 
 #define SIGNED(val) \
