+// ============================================================================
+// TS2 G121 SHUTDOWN TRACE - diagnostic instrumentation
+//
+// Question this answers: what actually decides the process is finished after
+// the Level 1 totals screen? Two candidate mechanisms produce the same
+// 0xC0000409 / fastfail subcode 7:
+//
+//   A. deinit_hook() fires DURING the Level 1 transition, because the level
+//      change drives the quit cascade. RmlUi is torn down mid-session and the
+//      next element release lands on a destroyed instancer.
+//   B. deinit_hook() fires only at genuine process exit, but elements survive
+//      destroy_all_contexts() and are released after their instancers die.
+//
+// The backtrace captured at deinit_hook entry names the caller directly. The
+// frame counter separates "the renderer is still running" from "the process is
+// ending". Output goes to ts2_g121_shutdown_trace.txt in the working directory;
+// RUN_TOY_STORY_2.cmd pushd's into the payload dir, so it lands beside the exe.
+//
+// Every line is flushed and the file closed on write, so a crash part way
+// through teardown still leaves a complete trace on disk.
+// ============================================================================
+namespace {
+    std::atomic<unsigned long long> ts2_g121_frame_counter{0};
+    std::mutex ts2_g121_trace_mutex;
+
+    void ts2_g121_trace(const char* fmt, ...) {
+        std::lock_guard<std::mutex> trace_lock(ts2_g121_trace_mutex);
+        std::FILE* f = std::fopen("ts2_g121_shutdown_trace.txt", "a");
+        if (f == nullptr) {
+            return;
+        }
+
+        const long long us = std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+#ifdef _WIN32
+        const unsigned long tid = ::GetCurrentThreadId();
+#else
+        const unsigned long tid = 0UL;
+#endif
+        std::fprintf(f, "t=%lld tid=%lu frame=%llu | ", us, tid,
+                     ts2_g121_frame_counter.load());
+
+        std::va_list args;
+        va_start(args, fmt);
+        std::vfprintf(f, fmt, args);
+        va_end(args);
+
+        std::fputc('\n', f);
+        std::fflush(f);
+        std::fclose(f);
+    }
+
+#ifdef _WIN32
+    // DbgHelp symbolization. G121 shipped the first PDB this project has had
+    // since G113, so backtraces can now resolve to function names in-process,
+    // written straight into the trace file. That removes the dependency on
+    // cdb.exe or any offline symbolization step.
+    std::mutex ts2_g121_sym_mutex;
+    std::atomic_bool ts2_g121_sym_ready{false};
+
+    void ts2_g121_sym_init() {
+        std::lock_guard<std::mutex> sym_lock(ts2_g121_sym_mutex);
+        if (ts2_g121_sym_ready.load()) {
+            return;
+        }
+        ::SymSetOptions(SYMOPT_DEFERRED_LOADS | SYMOPT_UNDNAME | SYMOPT_LOAD_LINES);
+        if (::SymInitialize(::GetCurrentProcess(), nullptr, TRUE)) {
+            ts2_g121_sym_ready.store(true);
+        }
+    }
+
+    // Resolves one address to "symbol+0xoff (file:line)". Returns false if the
+    // address could not be named, in which case the caller still has module+RVA.
+    bool ts2_g121_symbolize(void* addr, char* out, size_t out_size) {
+        if (!ts2_g121_sym_ready.load() || out_size == 0) {
+            return false;
+        }
+        std::lock_guard<std::mutex> sym_lock(ts2_g121_sym_mutex);
+
+        alignas(SYMBOL_INFO) char sym_buffer[sizeof(SYMBOL_INFO) + MAX_SYM_NAME] = {};
+        SYMBOL_INFO* sym = reinterpret_cast<SYMBOL_INFO*>(sym_buffer);
+        sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+        sym->MaxNameLen   = MAX_SYM_NAME;
+
+        DWORD64 displacement = 0;
+        if (!::SymFromAddr(::GetCurrentProcess(),
+                           reinterpret_cast<DWORD64>(addr),
+                           &displacement, sym)) {
+            return false;
+        }
+
+        IMAGEHLP_LINE64 line = {};
+        line.SizeOfStruct = sizeof(IMAGEHLP_LINE64);
+        DWORD line_disp = 0;
+        if (::SymGetLineFromAddr64(::GetCurrentProcess(),
+                                   reinterpret_cast<DWORD64>(addr),
+                                   &line_disp, &line) &&
+            line.FileName != nullptr) {
+            const char* slash = std::strrchr(line.FileName, '\\');
+            const char* file  = (slash != nullptr) ? (slash + 1) : line.FileName;
+            std::snprintf(out, out_size, "%s+0x%llX (%s:%lu)",
+                          sym->Name, (unsigned long long)displacement,
+                          file, (unsigned long)line.LineNumber);
+        } else {
+            std::snprintf(out, out_size, "%s+0x%llX",
+                          sym->Name, (unsigned long long)displacement);
+        }
+        return true;
+    }
+#endif
+
+    void ts2_g121_trace_backtrace(const char* label) {
+#ifdef _WIN32
+        void* frames[62] = {};
+        const unsigned short captured =
+            ::RtlCaptureStackBackTrace(0, 62, frames, nullptr);
+        ts2_g121_trace("%s: backtrace frames=%u", label, (unsigned)captured);
+
+        for (unsigned short i = 0; i < captured; ++i) {
+            HMODULE mod = nullptr;
+            char module_path[MAX_PATH] = {};
+            const char* base_name = "<unknown>";
+            unsigned long long rva = 0ULL;
+
+            if (::GetModuleHandleExA(
+                    GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                        GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                    reinterpret_cast<LPCSTR>(frames[i]), &mod) &&
+                mod != nullptr) {
+                if (::GetModuleFileNameA(mod, module_path, MAX_PATH) != 0) {
+                    const char* slash = std::strrchr(module_path, '\\');
+                    base_name = (slash != nullptr) ? (slash + 1) : module_path;
+                }
+                rva = static_cast<unsigned long long>(
+                    reinterpret_cast<const char*>(frames[i]) -
+                    reinterpret_cast<const char*>(mod));
+            }
+
+            char symbol[1024] = {};
+            if (ts2_g121_symbolize(frames[i], symbol, sizeof(symbol))) {
+                ts2_g121_trace("%s:   #%02u %s+0x%llX  %s", label, (unsigned)i,
+                               base_name, rva, symbol);
+            } else {
+                ts2_g121_trace("%s:   #%02u %s+0x%llX", label, (unsigned)i,
+                               base_name, rva);
+            }
+        }
+#else
+        ts2_g121_trace("%s: backtrace unavailable on this platform", label);
+#endif
+    }
+
+    // ------------------------------------------------------------------
+    // G122 forensic handlers.
+    //
+    // G121 proved deinit_hook() is NEVER called: the process dies at the
+    // Level 1 handoff without any orderly UI teardown, and the 0xC0000409
+    // is the CRT running static destructors over a still-live RmlUi world.
+    // These four handlers catch the exit in the act and name the caller.
+    // ------------------------------------------------------------------
+    std::atomic_bool ts2_g121_atexit_seen{false};
