+    }
+#endif
+
+    void ts2_g121_install_handlers() {
+#ifdef _WIN32
+        ts2_g121_sym_init();
+        _set_purecall_handler(ts2_g121_on_purecall);
+#endif
+        std::atexit(ts2_g121_on_atexit);
+        std::set_terminate(ts2_g121_on_terminate);
+        std::signal(SIGABRT, ts2_g121_on_sigabrt);
+    }
+}
