+// TS2: optional override for A/B testing presentation (TS2_PRESENTATION_MODE =
+// console | skip | early). PresentEarly guesses the displayed framebuffer from
+// VI history; TS2's level select renders its preview into a buffer that was
+// a display buffer earlier, which can flash on screen for a frame.
+static bool ts2_presentation_override(RT64::EnhancementConfiguration::Presentation::Mode& mode) {
+    const char* value = std::getenv("TS2_PRESENTATION_MODE");
+    if (value == nullptr) return false;
+    const std::string text = value;
+    if (text == "console") mode = RT64::EnhancementConfiguration::Presentation::Mode::Console;
+    else if (text == "skip") mode = RT64::EnhancementConfiguration::Presentation::Mode::SkipBuffering;
+    else if (text == "early") mode = RT64::EnhancementConfiguration::Presentation::Mode::PresentEarly;
+    else return false;
+    return true;
