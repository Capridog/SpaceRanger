new file mode 100644
index 0000000..a80a83e
--- /dev/null
+++ b/src/hle/rt64_geometry_identity.h
@@ -0,0 +1,57 @@
+#pragma once
+#include <algorithm>
+#include <cstring>
+#include <cstdint>
+#include <cstddef>
+#include <vector>
+
+namespace RT64 {
+    // Local position and UV identify surviving vertices even when CPU culling
+    // changes the submitted subset. Lighting colors are not geometry identity.
+    inline std::vector<uint64_t> geometryIdentity(const float* positions, const float* uvs, uint32_t count) {
+        std::vector<uint64_t> keys;
+        keys.reserve(count);
+        for(uint32_t i=0;i<count;++i) {
+            uint64_t hash=14695981039346656037ull;
+            for(uint32_t j=0;j<5;++j) {
+                float value=j<3?positions[i*3+j]:uvs[i*2+j-3];
+                if(value==0.0f)value=0.0f;
+                uint32_t bits;std::memcpy(&bits,&value,sizeof(bits));
+                hash=(hash^bits)*1099511628211ull;
+            }
+            keys.push_back(hash);
+        }
+        std::sort(keys.begin(),keys.end());
+        keys.erase(std::unique(keys.begin(),keys.end()),keys.end());
+        return keys;
+    }
+    // Per-index UV equality establishes temporal vertex correspondence only when
+    // the caller has also proven that face topology is stable. Positions are
+    // intentionally excluded so CPU-updated vertices can retain motion history.
+    inline bool compatibleVertexCorrespondence(const float* aUvs, uint32_t aCount, const float* bUvs, uint32_t bCount) {
+        return aCount > 0 && aCount == bCount &&
+            std::memcmp(aUvs, bUvs, std::size_t(aCount) * 2 * sizeof(float)) == 0;
+    }
+
+    inline float vertexCorrespondenceDifference(const float* aPositions, const float* bPositions, uint32_t count) {
+        double sum = 0.0;
+        for (uint32_t i = 0; i < count * 3; ++i) {
+            const double delta = double(aPositions[i]) - double(bPositions[i]);
+            sum += delta * delta;
+        }
+        return count > 0 ? float(sum / double(count * 3)) : 0.0f;
+    }
+
+    inline bool compatibleGeometryIdentity(const std::vector<uint64_t>& a,const std::vector<uint64_t>& b) {
+        const size_t smaller=std::min(a.size(),b.size());
+        if(smaller==0)return false;
+        if(smaller<6)return a==b;
+        size_t i=0,j=0,common=0;
+        while(i<a.size()&&j<b.size()) {
+            if(a[i]<b[j])++i;
+            else if(b[j]<a[i])++j;
+            else {++i;++j;++common;}
+        }
+        return common>=std::min(size_t(12),smaller)&&common*5>=smaller*3;
+    }
+}
