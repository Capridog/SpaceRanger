+            std::fprintf(stderr, "TS2 capture: recording up to 12 displayed frames in %s\n", directory.string().c_str());
+            // Which game function wrote which part of the recent frames' display lists.
+            ts2_write_emitter_history((directory / "emitters.json").string().c_str());
