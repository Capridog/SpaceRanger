diff --git a/src/hle/rt64_ts2_projection.h b/src/hle/rt64_ts2_projection.h
new file mode 100644
index 0000000..0a4a8e1
--- /dev/null
+++ b/src/hle/rt64_ts2_projection.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cmath>
+
+namespace RT64 {
+// TS2 submits detailed scenery with a short perspective far plane, separately
+// from its coarse background pass. Raising CPU draw limits alone leaves that
+// plane cutting through the detail. Use an infinite far plane while preserving
+// the original near plane, X/Y projection and homogeneous scale.
+template <typename Matrix>
+bool ts2RemovePerspectiveFarPlane(Matrix &p) {
+    if (float(p[3][3]) != 0.0f || float(p[0][3]) != 0.0f || float(p[1][3]) != 0.0f ||
+        float(p[0][2]) != 0.0f || float(p[1][2]) != 0.0f) return false;
+    const double a = float(p[2][2]), b = float(p[3][2]), c = float(p[2][3]);
+    if (!std::isfinite(a) || !std::isfinite(b) || !std::isfinite(c) ||
+        !(c < 0.0 && a < c && b < 0.0)) return false;
+    const double nearPlane = b / (a + c);
+    if (!std::isfinite(nearPlane) || !(nearPlane > 0.0)) return false;
+    p[2][2] = float(c);
+    p[3][2] = float(2.0 * nearPlane * c);
+    return true;
+}
+}
