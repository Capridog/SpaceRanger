@@ -3,14 +3,264 @@
 //
 
 #include "rt64_workload_queue.h"
+#include "rt64_ts2_capture.h"
 
 #include "common/rt64_thread.h"
 
 #include "rt64_present_queue.h"
 
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+
 #define ENABLE_HIGH_RESOLUTION_RENDERER 1
 
+extern "C" void ts2_set_render_aspect(float scale);
+
 namespace RT64 {
+    // TS2 HFR transition hard-cut support.
+    //
+    // RT64's automatic camera matching can legitimately keep an AUTO camera
+    // mapped across a semantic cut. When that happens, every generated display
+    // frame between the two native endpoints sees an in-between camera that the
+    // game never authored. RaceWave46 solved the same class of defect by
+    // suppressing the entire interpolation pair at a proven camera cut instead
+    // of breaking only the projection match.
+    //
+    // This detector is intentionally conservative:
+    //   * structural scene-count changes are always a cut;
+    //   * otherwise a camera jump must exceed a substantial angular/translation
+    //     threshold AND be at least 10x the previous frame-to-frame motion.
+    // The environment switch exists only for A/B testing. Default is enabled.
+    static bool ts2TransitionHardCutEnabled() {
+        static const bool enabled = [] {
+            const char *value = std::getenv("TS2_TRANSITION_HARD_CUT");
+            return (value == nullptr) || (value[0] != '0');
+        }();
+        return enabled;
+    }
+
+    struct Ts2TransitionMotionHistory {
+        float rotationDeg = 0.0f;
+        float translation = 0.0f;
+        bool valid = false;
+    };
+
+    static Ts2TransitionMotionHistory &ts2TransitionMotionHistory() {
+        static thread_local Ts2TransitionMotionHistory history;
+        return history;
+    }
+
+    template <typename WorkloadContainer>
+    static bool ts2TransitionFirstView(
+        const GameFrame &frame,
+        const WorkloadContainer &workloads,
+        const interop::float4x4 *&outView)
+    {
+        outView = nullptr;
+
+        const GameScene *scene = nullptr;
+        if (!frame.perspectiveScenes.empty()) {
+            scene = &frame.perspectiveScenes.front();
+        }
+        else if (!frame.orthographicScenes.empty()) {
+            scene = &frame.orthographicScenes.front();
+        }
+
+        if ((scene == nullptr) || scene->projections.empty()) {
+            return false;
+        }
+
+        const GameIndices::Projection &indices = scene->projections.front();
+        if (indices.workloadIndex >= workloads.size()) {
+            return false;
+        }
+
+        const Workload &owner = workloads[indices.workloadIndex];
+        if (indices.fbPairIndex >= owner.fbPairCount) {
+            return false;
+        }
+
+        const FramebufferPair &pair = owner.fbPairs[indices.fbPairIndex];
+        if (indices.projectionIndex >= pair.projectionCount) {
+            return false;
+        }
+
+        const Projection &projection = pair.projections[indices.projectionIndex];
+        if (projection.transformsIndex >= owner.drawData.viewTransforms.size()) {
+            return false;
+        }
+
+        outView = &owner.drawData.viewTransforms[projection.transformsIndex];
+        return true;
+    }
+
+    static float ts2TransitionBasisAngleDeg(
+        const interop::float4x4 &previous,
+        const interop::float4x4 &current)
+    {
+        constexpr float RadToDeg = 57.29577951308232f;
+        float maxAngle = 0.0f;
+
+        // Evaluate all three camera basis vectors so yaw, pitch and roll cuts are
+        // all visible to the detector. Matrix storage matches the existing RT64
+        // row access used throughout the TS2 integration.
+        for (uint32_t basis = 0; basis < 3; ++basis) {
+            const float px = previous[basis][0];
+            const float py = previous[basis][1];
+            const float pz = previous[basis][2];
+            const float cx = current[basis][0];
+            const float cy = current[basis][1];
+            const float cz = current[basis][2];
+
+            const float pLen = std::sqrt(px * px + py * py + pz * pz);
+            const float cLen = std::sqrt(cx * cx + cy * cy + cz * cz);
+            if ((pLen <= 1e-6f) || (cLen <= 1e-6f)) {
+                continue;
+            }
+
+            float dot = (px * cx + py * cy + pz * cz) / (pLen * cLen);
+            dot = std::clamp(dot, -1.0f, 1.0f);
+            maxAngle = std::max(maxAngle, std::acos(dot) * RadToDeg);
+        }
+
+        return maxAngle;
+    }
+
+    template <typename WorkloadContainer>
+    static bool ts2TransitionHardCut(
+        const GameFrame &currentFrame,
+        const GameFrame &previousFrame,
+        const WorkloadContainer &workloads,
+        uint64_t submissionFrame)
+    {
+        if (!ts2TransitionHardCutEnabled()) {
+            return false;
+        }
+
+        const bool structuralCut =
+            (currentFrame.perspectiveScenes.size() != previousFrame.perspectiveScenes.size()) ||
+            (currentFrame.orthographicScenes.size() != previousFrame.orthographicScenes.size()) ||
+            (currentFrame.workloads.size() != previousFrame.workloads.size());
+
+        const interop::float4x4 *currentView = nullptr;
+        const interop::float4x4 *previousView = nullptr;
+        const bool haveCurrentView = ts2TransitionFirstView(currentFrame, workloads, currentView);
+        const bool havePreviousView = ts2TransitionFirstView(previousFrame, workloads, previousView);
+
+        float rotationDeg = 0.0f;
+        float translation = 0.0f;
+        bool cameraCut = false;
+
+        Ts2TransitionMotionHistory &history = ts2TransitionMotionHistory();
+
+        if (haveCurrentView && havePreviousView) {
+            const float dx = (*currentView)[3][0] - (*previousView)[3][0];
+            const float dy = (*currentView)[3][1] - (*previousView)[3][1];
+            const float dz = (*currentView)[3][2] - (*previousView)[3][2];
+            translation = std::sqrt(dx * dx + dy * dy + dz * dz);
+            rotationDeg = ts2TransitionBasisAngleDeg(*previousView, *currentView);
+
+            constexpr float RotationToleranceDeg = 12.0f;
+            constexpr float TranslationTolerance = 1000.0f;
+            constexpr float RatioTolerance = 10.0f;
+            constexpr float Epsilon = 1e-6f;
+
+            const float rotationRatio = history.valid
+                ? (rotationDeg / std::max(history.rotationDeg, Epsilon))
+                : 1.0e30f;
+            const float translationRatio = history.valid
+                ? (translation / std::max(history.translation, Epsilon))
+                : 1.0e30f;
+
+            cameraCut =
+                ((rotationDeg >= RotationToleranceDeg) && (rotationRatio >= RatioTolerance)) ||
+                ((translation >= TranslationTolerance) && (translationRatio >= RatioTolerance));
+
+            history.rotationDeg = rotationDeg;
+            history.translation = translation;
+            history.valid = true;
+        }
+        else {
+            // A projection family appearing/disappearing is itself a semantic
+            // boundary. Reset motion history so the next real camera starts clean.
+            history = {};
+        }
+
+        // A projection appearing/disappearing (particles, laser, sprites) is
+        // routine during play; only treat it as a cut when the workload set
+        // changes or the camera also moved a lot (entering first-person, a
+        // scripted camera). Otherwise it cost an interpolated frame every few
+        // seconds of gameplay.
+        const bool workloadChange = currentFrame.workloads.size() != previousFrame.workloads.size();
+        // Effects add or remove a single perspective pass; first-person
+        // enter/exit swaps several at once (4 <-> 2) with a small camera move.
+        const size_t curPersp = currentFrame.perspectiveScenes.size(), prevPersp = previousFrame.perspectiveScenes.size();
+        const bool passSwap = (curPersp > prevPersp ? curPersp - prevPersp : prevPersp - curPersp) >= 2 ||
+            (currentFrame.orthographicScenes.size() != previousFrame.orthographicScenes.size());
+        // First-person enter/exit: the camera-locked arm (label 2) appears or
+        // disappears. Leaving first person the game places the camera just
+        // behind Buzz, so the move is small but blending it draws Buzz huge.
+        auto lockedVertices = [&](const GameFrame &frame) {
+            uint32_t count = 0;
+            for (uint32_t index : frame.workloads) {
+                const DrawData &d = workloads[index].drawData;
+                for (uint32_t t = 1; t < d.ts2WorldCameraLocked.size() && t < d.worldTransforms.size(); ++t)
+                    if (d.ts2WorldCameraLocked[t] == 2) count += d.worldTransformVertexCount(t);
+            }
+            return count;
+        };
+        const uint32_t curLocked = lockedVertices(currentFrame), prevLocked = lockedVertices(previousFrame);
+        // HUD/reticle quads are also camera-locked (< ~100 vertices); the arm
+        // adds several hundred.
+        const uint32_t moreLocked = std::max(curLocked, prevLocked), lessLocked = std::min(curLocked, prevLocked);
+        (void)moreLocked; (void)lessLocked;
+        // Leaving first person drops the arm (several hundred camera-locked
+        // vertices) at once; entering adds it. Cut only that unmatched pair.
+        // Holding two more complete native frames made repeated camera toggles
+        // look like a 30 Hz stall. Later camera motion can interpolate normally;
+        // the separate camera-jump detector still catches a genuine new cut.
+        bool firstPersonToggle = (prevLocked >= curLocked + 300) && (curLocked * 2 < prevLocked);
+        // Entering first person the camera jumps into Buzz's head; a blended
+        // frame shows his back filling the screen, so cut there too.
+        if ((curLocked >= prevLocked + 300) && (prevLocked * 2 < curLocked)) firstPersonToggle = true;
+        const bool cut = (structuralCut && (workloadChange || passSwap || !haveCurrentView || !havePreviousView ||
+            rotationDeg >= 10.0f || translation >= 1500.0f)) || cameraCut || firstPersonToggle;
+        const bool lockedJump = (moreLocked - lessLocked) >= 150;
+        // Transition diagnostics must never open and close a file on the game
+        // thread for every first-person toggle. Leave them off during play.
+        static FILE *transitionLog = []() -> FILE * {
+            const char *path = std::getenv("TS2_TRANSITION_LOG");
+            if ((path == nullptr) || (path[0] == '\0')) return nullptr;
+            return std::fopen((path[0] == '1' && path[1] == '\0') ? "transition-hard-cuts.log" : path, "a");
+        }();
+        if (transitionLog && (cut || lockedJump)) {
+            std::fprintf(
+                transitionLog,
+                "frame=%llu cut=%d fp=%d locked=%u->%u structural=%d camera=%d rotation_deg=%.6f translation=%.6f "
+                "perspective=%zu->%zu ortho=%zu->%zu workloads=%zu->%zu\n",
+                static_cast<unsigned long long>(submissionFrame), cut ? 1 : 0, firstPersonToggle ? 1 : 0,
+                prevLocked, curLocked,
+                structuralCut ? 1 : 0,
+                cameraCut ? 1 : 0,
