diff --git a/src/hle/rt64_task_memory.h b/src/hle/rt64_task_memory.h
new file mode 100644
index 0000000..7838a96
--- /dev/null
+++ b/src/hle/rt64_task_memory.h
@@ -0,0 +1,30 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+namespace RT64 {
+// NativeTarget::copyToRAM consumes a queued readback. Mirror its completed,
+// word-swapped CPU bytes instead of consuming the next readback a second time.
+template<typename Writer>
+void writeTaskFramebuffer(uint8_t* task, uint8_t* guest, uint32_t offset, uint32_t bytes, Writer write) {
+    write(task);
+    if (task != guest && bytes != 0) {
+        const uint32_t first = offset & ~3u;
+        const uint32_t end = (offset + bytes + 3u) & ~3u;
+        std::memcpy(guest + first, task + first, end - first);
+    }
+}
+// The task owns this memory until synchronous display-list decoding completes.
+// All indirect reads must see the same bytes as the root display list.
+class TaskMemoryScope {
+    uint8_t*& source;
+    uint8_t* previous;
+public:
+    TaskMemoryScope(uint8_t*& source, uint8_t* snapshot) : source(source), previous(source) {
+        if (snapshot != nullptr) source = snapshot;
+    }
+    ~TaskMemoryScope() { source = previous; }
+    TaskMemoryScope(const TaskMemoryScope&) = delete;
+    TaskMemoryScope& operator=(const TaskMemoryScope&) = delete;
+};
+}
diff --git a/src/hle/rt64_ts2_camera.h b/src/hle/rt64_ts2_camera.h
new file mode 100644
index 0000000..943714e
--- /dev/null
+++ b/src/hle/rt64_ts2_camera.h
@@ -0,0 +1,129 @@
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <unordered_set>
+#include "common/rt64_common.h"
+
+namespace RT64 {
+// TS2 stores a PS1-style 12-bit camera rotation and world coordinates before
+// CPU-transforming scenery into N64 vertices. N64 vertices use world / 32,
+// with Y and Z reversed. Read the immutable display-list RDRAM snapshot.
+inline bool ts2ReadCamera(const uint8_t* rdram, hlslpp::float4x4& camera) {
+    uint32_t address;
+    std::memcpy(&address, rdram + 0xBAC4C, 4);
+    if (address < 0x80000000u || address > 0x807FFF80u) return false;
+    const uint32_t base = address & 0x7FFFFFu;
+    auto word = [&](uint32_t p) { int32_t v; std::memcpy(&v, rdram + p, 4); return v; };
+    auto half = [&](uint32_t p) { int16_t v; std::memcpy(&v, rdram + (p ^ 2), 2); return v; };
+    float rotation[3][3];
+    for (int row = 0; row < 3; ++row) {
+        for (int col = 0; col < 3; ++col)
+            rotation[row][col] = half(base + 0x20 + (row * 3 + col) * 2) / 4096.0f;
+        for (int other = 0; other <= row; ++other) {
+            float dot = 0;
+            for (int col = 0; col < 3; ++col) dot += rotation[row][col] * rotation[other][col];
+            if (std::abs(dot - (row == other ? 1.0f : 0.0f)) > 0.02f) return false;
+        }
+    }
+    camera = hlslpp::float4x4::identity();
+    for (int col = 0; col < 3; ++col) {
+        float translation = 0;
+        for (int row = 0; row < 3; ++row) {
+            const float value = rotation[col][row] * (col == 0 ? 1.0f : -1.0f);
+            camera[row][col] = value;
+            translation -= (word(base + row * 4) / 32.0f) * value;
+        }
+        camera[3][col] = translation;
+    }
+    return true;
+}
+
+// Camera-space (CPU-transformed) scenery keeps the same camera-relative
+// transform while only its camera-to-world matrix moves. Actors change their
+// camera-relative transform whenever they or the camera move (by whole units;
+// scenery differs only by float rounding of the camera matrix).
+template <typename Matrix>
+inline bool ts2CameraSpaceGeometry(const Matrix& curRelative, const Matrix& prevRelative,
+    const Matrix& curWorld, const Matrix& prevWorld) {
+    float relativeDiff = 0.0f, worldDiff = 0.0f;
+    for (int row = 0; row < 4; ++row) {
+        for (int col = 0; col < 4; ++col) {
+            const float a = float(curRelative[row][col]);
+            const float b = float(prevRelative[row][col]);
+            if (!std::isfinite(a) || !std::isfinite(b)) return false;
+            relativeDiff = std::fmax(relativeDiff, std::fabs(a - b));
+            worldDiff = std::fmax(worldDiff, std::fabs(float(curWorld[row][col]) - float(prevWorld[row][col])));
+        }
+    }
+    // Absolute N64 units: rounding noise only, never real relative motion.
+    return relativeDiff <= 2e-3f && worldDiff > 1e-4f;
+}
+
+// TS2's CPU scenery pass always loads its camera-to-world matrix from this
+// static buffer (physical 0x1ED830). Other camera-relative geometry is
+// camera-locked (e.g. the first-person reticle) and must not be held.
+inline bool ts2IsSceneryMatrix(uint32_t physicalAddress) {
+    static const bool anyAddress = [] {
+        const char* v = std::getenv("TS2_CAMERA_HOLD_ANY_MATRIX");
+        return v && v[0] == '1';
+    }();
+    return anyAddress || (physicalAddress & 0x1FFFFFFFu) == 0x001ED830u;
+}
+
+inline bool ts2CameraHoldDiagnostics() {
+    static const bool enabled = std::getenv("TS2_VISIBILITY_DIAGNOSTICS") != nullptr;
+    return enabled;
+}
+
+// Log each distinct camera-locked matrix once (bounded).
+inline void ts2NoteCameraLockedMatrix(uint32_t physicalAddress, uint32_t vertices) {
+    static uint32_t seen[32] = {};
+    static uint32_t count = 0;
+    for (uint32_t i = 0; i < count; ++i) if (seen[i] == physicalAddress) return;
+    if (count >= 32) return;
+    seen[count++] = physicalAddress;
+    std::fprintf(stderr, "TS2 interpolation: camera-locked matrix %08X (%u vertices) keeps matrix interpolation\n",
+        physicalAddress, vertices);
+}
+
+// Render objects (TS2 object addresses) detected as camera-locked, e.g. the
+// first-person Buzz body. Written by frame matching, read by the RSP when
+// vertices load (one-frame lag). Guarded by its own mutex.
+struct Ts2LockedObjects {
+    std::mutex mutex;
+    std::unordered_set<int32_t> objects;
+};
+inline Ts2LockedObjects& ts2LockedObjects() {
+    static Ts2LockedObjects value;
+    return value;
+}
+inline bool ts2IsLockedObject(int32_t object) {
+    if (object < 0) return false;
+    auto& locked = ts2LockedObjects();
+    std::lock_guard<std::mutex> lock(locked.mutex);
+    return locked.objects.count(object) != 0;
+}
+
+// Classify one object from its camera-space centroid in two frames.
+// predicted: where the previous centroid would be now if the object were
+// fixed in the world. Returns +1 camera-locked, -1 world-static, 0 unknown.
+inline int ts2ClassifyObjectMotion(const hlslpp::float3& previous, const hlslpp::float3& current,
+    const hlslpp::float3& predicted) {
+    const float cameraMove = float(hlslpp::length(predicted - previous));
+    if (!(cameraMove > 1.0f)) return 0;
+    const float lockedError = float(hlslpp::length(current - previous));
+    const float staticError = float(hlslpp::length(current - predicted));
+    if (lockedError < 0.35f * cameraMove && staticError > 0.5f * cameraMove) return 1;
+    if (staticError < 0.35f * cameraMove && lockedError > 0.5f * cameraMove) return -1;
+    return 0;
+}
+
+inline hlslpp::float4x4 ts2CameraCompensation(const hlslpp::float4x4& originalView,
+    const hlslpp::float4x4& camera) {
+    return hlslpp::mul(originalView, hlslpp::inverse(camera));
+}
+}
diff --git a/src/hle/rt64_ts2_capture.cpp b/src/hle/rt64_ts2_capture.cpp
new file mode 100644
index 0000000..e750f70
--- /dev/null
+++ b/src/hle/rt64_ts2_capture.cpp
@@ -0,0 +1,255 @@
+#include "rt64_ts2_capture.h"
+#include "rt64_workload_queue.h"
+#include <atomic>
+#include <thread>
+#include <vector>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <json/json.hpp>
+
+namespace {
+std::atomic<bool> requested{false}, busy{false};
+std::atomic<unsigned> sessions{0};
+constexpr unsigned FramesPerSession = 12;
+// TS2_CAPTURE_MAX_SESSIONS raises the default of 3 captures per run.
+static const unsigned MaxSessions = [] {
+    const char* v = std::getenv("TS2_CAPTURE_MAX_SESSIONS");
+    const long n = v ? std::strtol(v, nullptr, 10) : 0;
+    return n > 0 ? unsigned(n) : 3u;
+}();
+constexpr size_t MaxSessionBytes = 32 * 1024 * 1024;
+using Json = nlohmann::json;
+
+int64_t milliseconds() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+Json matrices(const std::vector<interop::float4x4>& values) {
+    Json result = Json::array();
+    for (const auto& value : values) {
+        Json matrix = Json::array();
+        for (int r = 0; r < 4; ++r) for (int c = 0; c < 4; ++c)
+            matrix.push_back(float(value[r][c]));
+        result.push_back(std::move(matrix));
+    }
+    return result;
+}
+
+Json rect(const RT64::FixedRect& value) {
+    return {value.ulx, value.uly, value.lrx, value.lry};
+}
+}
+
+// Provided by the game project (render provenance marks from emitter hooks).
+extern "C" void ts2_write_emitter_history(const char* path);
+
+extern "C" bool ts2_request_frame_capture() {
+    static const bool enabled = std::getenv("TS2_FRAME_CAPTURE") != nullptr;
+    if (!enabled || sessions.load() >= MaxSessions || busy.exchange(true)) return false;
+    requested.store(true);
+    return true;
+}
+
+namespace {
+// Captured frames are copied cheaply on the render thread and serialized to
+// JSON on a background thread once the session is complete: building the JSON
+// inline took tens of milliseconds per frame and stalled the interpolated
+// frames the capture is meant to observe.
+struct CapturedWorkload {
+    Json meta;
+    Json calls;
+    RT64::DrawData data;
+    std::vector<std::pair<bool, uint32_t>> matches;
+    bool interpolatedWorld = false;
+    bool processedProjections = false;
+};
+struct CapturedFrame {
+    Json head;
+    std::vector<CapturedWorkload> workloads;
+};
+
+Json serializeWorkload(const CapturedWorkload& w) {
+    const auto& data = w.data;
+    Json item = w.meta;
+    item["positions"] = data.posFloats; item["velocities"] = data.velFloats;
+    item["uvs"] = data.tcFloats; item["norm_colors"] = data.normColBytes;
+    item["faces"] = data.faceIndices; item["world_indices"] = data.worldIndices;
+    item["projection_indices"] = data.viewProjIndices; item["modify_positions"] = data.modifyPosUints;
+    item["matrix_addresses"] = data.worldTransformPhysicalAddresses;
+    item["world_dl"] = data.ts2WorldCommandAddresses;
+    item["vertex_objects"] = data.ts2VertexObjects; item["world_locked"] = data.ts2WorldCameraLocked;
+    item["matrix_vertex_starts"] = data.worldTransformVertexIndices;
+    item["world_native"] = matrices(data.worldTransforms);
+    item["world_display"] = matrices(w.interpolatedWorld ? data.lerpWorldTransforms : data.worldTransforms);
+    item["view_projection_native"] = matrices(data.viewProjTransforms);
+    item["view_projection_display"] = matrices(w.processedProjections ? data.modViewProjTransforms : data.viewProjTransforms);
+    Json viewports = Json::array();
+    for (const auto& viewport : data.rspViewports) {
+        viewports.push_back({float(viewport.scale.x), float(viewport.scale.y), float(viewport.scale.z),
+            float(viewport.translate.x), float(viewport.translate.y), float(viewport.translate.z)});
+    }
+    item["viewports"] = std::move(viewports);
+    Json matches = Json::array();
+    for (const auto& m : w.matches) matches.push_back({{"mapped", m.first}, {"previous_index", m.second}});
+    item["matches"] = std::move(matches);
+    item["calls"] = w.calls;
+    return item;
+}
+}
+
+namespace RT64 {
+void ts2CaptureDisplayFrame(const WorkloadQueue& queue, const GameFrame& frame,
+    float weight, float aspect, bool processedTransforms, bool processedProjections) {
+    if (!busy.load(std::memory_order_relaxed)) return;
+    static std::filesystem::path directory;
+    static unsigned remaining = 0;
+    static std::vector<CapturedFrame> pending;
+    try {
+        if (requested.exchange(false)) {
+            const unsigned session = sessions.fetch_add(1) + 1;
+            directory = std::filesystem::path("render-captures") /
+                (std::to_string(milliseconds()) + "-" + std::to_string(session));
+            std::filesystem::create_directories(directory.parent_path());
+            if (!std::filesystem::create_directory(directory))
+                throw std::runtime_error("capture directory already exists");
+            remaining = FramesPerSession;
