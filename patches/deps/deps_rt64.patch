+                {"submission_frame", workload.submissionFrame}, {"present_id", workload.presentId},
+                {"original_rate", workload.viOriginalRate}};
+            w.data = workload.drawData;
+            w.interpolatedWorld = processedTransforms && mapping.mapped;
+            w.processedProjections = processedProjections;
+            for (const auto& match : mapping.transforms) w.matches.emplace_back(match.mapped, match.prevTransformIndex);
+            w.calls = Json::array();
+            for (uint32_t f = 0; f < workload.fbPairCount; ++f) {
+                const auto& pair = workload.fbPairs[f];
+                for (uint32_t p = 0; p < pair.projectionCount; ++p) {
+                    const auto& projection = pair.projections[p];
+                    for (uint32_t c = 0; c < projection.gameCallCount; ++c) {
+                        const auto& call = projection.gameCalls[c];
+                        const auto& desc = call.callDesc;
+                        w.calls.push_back({{"framebuffer", pair.colorImage.address},
+                            {"dl", call.ts2CommandAddress}, {"emitter", call.ts2Emitter}, {"model", call.ts2Model},
+                            {"projection", projection.transformsIndex}, {"type", int(projection.type)},
+                            {"face_start", call.meshDesc.faceIndicesStart}, {"triangles", desc.triangleCount},
+                            {"world_min", desc.minWorldMatrix}, {"world_max", desc.maxWorldMatrix},
+                            {"geometry_mode", desc.geometryMode}, {"cull_mask", desc.cullBothMask},
+                            {"other_mode", {desc.otherMode.L, desc.otherMode.H}},
+                            {"fill", desc.fillColor}, {"rect", rect(desc.rect)}, {"scissor", rect(desc.scissorRect)}});
+                    }
+                }
+            }
+            captured.workloads.push_back(std::move(w));
+        }
+        pending.push_back(std::move(captured));
+        --remaining;
+        if (remaining == 0) {
+            std::thread([frames = std::move(pending), dir = directory]() {
+                size_t bytes = 0;
+                for (size_t i = 0; i < frames.size(); ++i) {
+                    Json output = frames[i].head;
+                    output["workloads"] = Json::array();
+                    for (const auto& w : frames[i].workloads) output["workloads"].push_back(serializeWorkload(w));
+                    const std::string payload = output.dump();
+                    std::ofstream file(dir / ("display-" + std::to_string(i) + ".json"), std::ios::binary);
+                    file.write(payload.data(), std::streamsize(payload.size()));
+                    bytes += payload.size();
+                }
+                std::fprintf(stderr, "TS2 capture: saved %zu bytes in %s\n", bytes, dir.string().c_str());
+            }).detach();
+            pending = {};
+            busy.store(false);
+        }
+    }
+    catch (const std::exception& error) {
+        remaining = 0;
+        pending.clear();
+        busy.store(false);
+        std::fprintf(stderr, "TS2 capture failed: %s\n", error.what());
+    }
+}
+}
+
+namespace RT64 {
+// TS2_DISPLAY_METRICS=path: one CSV row per displayed frame with the screen
+// (NDC) centroid of camera-locked geometry as it is actually drawn (vertex
+// velocity, interpolated world and view-projection applied). Used by the
+// automated replay test to measure first-person arm/reticle smoothness.
+void ts2MeasureDisplayFrame(const WorkloadQueue& queue, const GameFrame& frame,
+    float weight, bool processedTransforms, bool processedProjections) {
+    static FILE* file = [] {
+        const char* path = std::getenv("TS2_DISPLAY_METRICS");
+        FILE* f = path ? std::fopen(path, "w") : nullptr;
+        if (f) std::fprintf(f, "display,submission,weight,interp,label,key,count,ndc_x,ndc_y\n");
+        return f;
+    }();
+    if (!file) return;
+    // TS2_DISPLAY_METRICS_ALL=1: every group, not only camera-locked ones.
+    static const bool allGroups = std::getenv("TS2_DISPLAY_METRICS_ALL") != nullptr;
+    static uint64_t display = 0;
+    ++display;
+    for (uint32_t index : frame.workloads) {
+        const auto& workload = queue.workloads[index];
+        const auto& d = workload.drawData;
+        const bool interpolated = processedTransforms && frame.frameMap.workloads[index].mapped;
+        const auto& worlds = interpolated && d.lerpWorldTransforms.size() == d.worldTransforms.size() ? d.lerpWorldTransforms : d.worldTransforms;
+        const auto& viewProjs = processedProjections && d.modViewProjTransforms.size() == d.viewProjTransforms.size() ? d.modViewProjTransforms : d.viewProjTransforms;
+        {
+            struct Acc { double sx = 0, sy = 0; uint32_t n = 0; };
+            std::map<std::pair<int, int32_t>, Acc> groups;
+            const uint32_t vertices = uint32_t(d.worldIndices.size());
+            for (uint32_t v = 0; v < vertices; ++v) {
+                const uint32_t t = d.worldIndices[v];
+                if (t == 0 || t >= worlds.size()) continue;
+                // Label: 0 ordinary, 1/2 camera-locked. Key: vertex source object,
+                // else the matrix buffer (characters drawn with their own G_MTX).
+                const int label = t < d.ts2WorldCameraLocked.size() ? d.ts2WorldCameraLocked[t] : 0;
+                if (label == 0 && !allGroups) continue;
+                int32_t key = v < d.ts2VertexObjects.size() ? d.ts2VertexObjects[v] : -1;
+                if (key < 0 && t < d.worldTransformPhysicalAddresses.size())
+                    key = int32_t(0x3000000u | (d.worldTransformPhysicalAddresses[t] & 0xFFFFFFu));
+                const uint32_t pj = v < d.viewProjIndices.size() ? d.viewProjIndices[v] : 0;
+                if (pj >= viewProjs.size() || (v + 1) * 3 > d.posFloats.size()) continue;
+                hlslpp::float4 pos(d.posFloats[v * 3], d.posFloats[v * 3 + 1], d.posFloats[v * 3 + 2], 1.0f);
+                if (interpolated && (v + 1) * 3 <= d.velFloats.size()) {
+                    pos.xyz -= hlslpp::float3(d.velFloats[v * 3], d.velFloats[v * 3 + 1], d.velFloats[v * 3 + 2]) * (1.0f - weight);
+                }
+                const hlslpp::float4 clip = hlslpp::mul(hlslpp::mul(pos, hlslpp::float4x4(worlds[t])), hlslpp::float4x4(viewProjs[pj]));
+                const float w = float(clip.w);
+                if (!(w > 1e-4f)) continue;
+                Acc& acc = groups[{label, key}];
+                acc.sx += float(clip.x) / w;
+                acc.sy += float(clip.y) / w;
+                ++acc.n;
+            }
+            for (const auto& [id, acc] : groups) {
+                std::fprintf(file, "%llu,%llu,%.4f,%d,%d,%X,%u,%.6f,%.6f\n", (unsigned long long)display,
+                    (unsigned long long)workload.submissionFrame, weight, int(interpolated), id.first, unsigned(id.second),
+                    acc.n, acc.sx / acc.n, acc.sy / acc.n);
+            }
+        }
+    }
+    if ((display & 63) == 0) std::fflush(file);
+}
+}
