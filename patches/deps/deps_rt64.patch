+namespace RT64 {
+    // GPU attachment clears do not inherit the rasterizer's scissor state.
+    inline plume::RenderRect intersectRenderRects(const plume::RenderRect &rect, const plume::RenderRect &scissor) {
+        return {
+            (std::max)(rect.left, scissor.left),
+            (std::max)(rect.top, scissor.top),
+            (std::min)(rect.right, scissor.right),
+            (std::min)(rect.bottom, scissor.bottom)
+        };
+    }
+}
