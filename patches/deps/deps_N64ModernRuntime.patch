diff --git a/librecomp/src/pak_store.hpp b/librecomp/src/pak_store.hpp
new file mode 100644
index 0000000..d894e13
--- /dev/null
+++ b/librecomp/src/pak_store.hpp
@@ -0,0 +1,74 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// Host note container, deliberately versioned separately from raw N64 Pak images.
+namespace recomp::pak {
+constexpr uint32_t capacity = 123 * 256;
+struct Note {
+    uint32_t game = 0;
+    uint16_t company = 0;
+    std::array<uint8_t, 16> name{};
+    std::array<uint8_t, 4> extension{};
+    std::vector<uint8_t> data;
+};
+struct Store {
+    std::array<Note, 16> notes;
+    uint32_t used() const {
+        uint32_t result = 0;
+        for (const auto& n : notes) result += uint32_t(n.data.size());
+        return result;
+    }
+    int find(const Note& key) const {
+        for (int i = 0; i < 16; ++i) {
+            const auto& n = notes[i];
+            if (!n.data.empty() && n.company == key.company && n.game == key.game &&
+                n.name == key.name && n.extension == key.extension) return i;
+        }
+        return -1;
+    }
+    static uint32_t checksum(const std::vector<uint8_t>& bytes, size_t size) {
+        uint32_t hash = 2166136261u;
+        for (size_t i = 0; i < size; ++i) hash = (hash ^ bytes[i]) * 16777619u;
+        return hash;
+    }
+    std::vector<uint8_t> encode() const {
+        std::vector<uint8_t> bytes{'T','S','2','P','A','K',0,1};
+        auto word = [&](uint32_t x) { for (int s = 24; s >= 0; s -= 8) bytes.push_back(uint8_t(x >> s)); };
+        for (const auto& n : notes) {
+            word(n.game); word(n.company); word(uint32_t(n.data.size()));
+            bytes.insert(bytes.end(), n.name.begin(), n.name.end());
+            bytes.insert(bytes.end(), n.extension.begin(), n.extension.end());
+            bytes.insert(bytes.end(), n.data.begin(), n.data.end());
+        }
+        word(checksum(bytes, bytes.size()));
+        return bytes;
+    }
+    bool decode(const std::vector<uint8_t>& bytes) {
+        const std::array<uint8_t, 8> magic{'T','S','2','P','A','K',0,1};
+        if (bytes.size() < 524 || bytes.size() > 524 + capacity ||
+            !std::equal(magic.begin(), magic.end(), bytes.begin())) return false;
+        size_t p = 8;
+        auto word = [&](size_t at) { return (uint32_t(bytes[at]) << 24) | (uint32_t(bytes[at+1]) << 16) |
+            (uint32_t(bytes[at+2]) << 8) | bytes[at+3]; };
+        if (word(bytes.size()-4) != checksum(bytes, bytes.size()-4)) return false;
+        Store result;
+        for (auto& n : result.notes) {
+            if (p + 32 > bytes.size()-4) return false;
+            n.game = word(p); const auto company = word(p+4); const auto size = word(p+8);
+            if (company > 65535 || size > capacity || size % 256 || p+32+size > bytes.size()-4) return false;
+            n.company = uint16_t(company);
+            std::copy_n(bytes.begin()+p+12, 16, n.name.begin());
+            std::copy_n(bytes.begin()+p+28, 4, n.extension.begin());
+            n.data.assign(bytes.begin()+p+32, bytes.begin()+p+32+size);
+            p += 32 + size;
+        }
+        if (p != bytes.size()-4 || result.used() > capacity) return false;
+        *this = std::move(result);
+        return true;
+    }
+};
+}
